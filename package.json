    "start": "PORT=${PORT:-${REACT_APP_PORT:-3002}} next start -H 0.0.0.0 -p ${PORT:-${REACT_APP_PORT:-3002}}",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/node": "4.1.0",
    "@tailwindcss/oxide": "4.1.0",
    "@tailwindcss/postcss": "4.1.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.2.4",
    "tailwindcss": "4.1.0",
    "typescript": "^5.7.3"
  }

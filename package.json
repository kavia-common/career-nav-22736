{
  "name": "career-nav-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-${REACT_APP_PORT:-3002}} next dev --hostname 0.0.0.0 --port ${PORT:-${REACT_APP_PORT:-3002}}",
